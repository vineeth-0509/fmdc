# Names only: copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SESSION_SECRET=replace-with-a-random-string-of-32-or-more-characters
# Mock OTP: with demo mode on, every login code is OTP_DEMO_CODE (assumption A8).
OTP_DEMO_MODE=true
OTP_DEMO_CODE=000000
# Name shown in the app header (optional).
NEXT_PUBLIC_BRAND_NAME=Retailer Orders
# Show the demo phone numbers on the login screen (set false to hide them).
NEXT_PUBLIC_DEMO_HINTS=true
# AI order capture (assumption A9) uses Google AI (Gemini). Get a key at https://aistudio.google.com/apikey
# Leave blank to use the keyword matcher only.
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Optional: use real photos from public/products/<SKU code>.webp (products without a photo keep the drawn pack).
NEXT_PUBLIC_PRODUCT_PHOTOS=false
# Optional: a Google image model, only for `npm run ai:images` (generates product pictures).
IMAGE_MODEL=
